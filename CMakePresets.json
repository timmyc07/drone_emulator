{
  "version": 2,
  "cmakeMinimumRequired": {"major": 3, "minor": 20, "patch": 0},
  "configurePresets": [
    {"name": "macos-arm64-debug", "displayName": "macOS ARM64 Debug", "generator": "Ninja", "binaryDir": "${sourceDir}/build/macos-arm64-debug", "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "BUILD_TESTING": "ON"}},
    {"name": "windows-x64-debug", "displayName": "Windows x64 Debug", "generator": "Ninja", "binaryDir": "${sourceDir}/build/windows-x64-debug", "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "BUILD_TESTING": "ON"}}
  ],
  "buildPresets": [
    {"name": "macos-arm64-debug", "configurePreset": "macos-arm64-debug", "jobs": 2},
    {"name": "windows-x64-debug", "configurePreset": "windows-x64-debug", "jobs": 2}
  ],
  "testPresets": [
    {"name": "macos-arm64-debug", "configurePreset": "macos-arm64-debug", "output": {"outputOnFailure": true}, "execution": {"noTestsAction": "error"}},
    {"name": "windows-x64-debug", "configurePreset": "windows-x64-debug", "output": {"outputOnFailure": true}, "execution": {"noTestsAction": "error"}}
  ]
}
