{
  "version": 6,
  "cmakeMinimumRequired": {"major": 3, "minor": 20, "patch": 0},
  "configurePresets": [
    {"name": "macos-arm64-debug", "displayName": "macOS ARM64 Debug", "generator": "Ninja", "binaryDir": "${sourceDir}/build/macos-arm64-debug", "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug"}},
    {"name": "windows-x64-debug", "displayName": "Windows x64 Debug", "generator": "Ninja", "binaryDir": "${sourceDir}/build/windows-x64-debug", "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug"}}
  ],
  "buildPresets": [
    {"name": "macos-arm64-debug", "configurePreset": "macos-arm64-debug"},
    {"name": "windows-x64-debug", "configurePreset": "windows-x64-debug"}
  ],
  "testPresets": [
    {"name": "macos-arm64-debug", "configurePreset": "macos-arm64-debug", "output": {"outputOnFailure": true}},
    {"name": "windows-x64-debug", "configurePreset": "windows-x64-debug", "output": {"outputOnFailure": true}}
  ]
}
